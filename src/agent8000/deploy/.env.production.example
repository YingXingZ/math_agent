# Copy to a server-only .env file. Never commit the real values.
AUTH_REQUIRED=true
COOKIE_SECURE=true
SESSION_DAYS=14
BOOTSTRAP_ADMIN_USERNAME=replace_with_admin_login
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_unique_password
DATABASE_PATH=/var/lib/math-agent/homework.db
UPLOAD_DIR=/var/lib/math-agent/uploads
EVIDENCE_API_URL=http://127.0.0.1:8014/api
QWEN_GRADING_URL=http://127.0.0.1:18080/grade-homework
SUBMISSION_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
