# 复制为 .env.production 后填写；真实密码/密钥绝不提交 Git。
AUTH_REQUIRED=true
COOKIE_SECURE=true
SESSION_DAYS=14
BOOTSTRAP_ADMIN_USERNAME=replace_with_admin_login
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_unique_password
SUBMISSION_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730

# Shared only between 8001 and private 8014 service
EVIDENCE_API_KEY=generate-a-long-random-secret
WORKBENCH_MODE=production
WORKBENCH_INTERNAL_API_KEY=generate-the-same-long-random-secret
WORKBENCH_CORS_ORIGINS=https://your-domain.example
