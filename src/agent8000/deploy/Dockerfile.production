FROM python:3.12-slim

WORKDIR /srv/app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils curl \
    && rm -rf /var/lib/apt/lists/*

COPY agent8000/requirements.txt ./
RUN pip install -r requirements.txt

COPY agent8000/app ./app
COPY grading_engine.py /srv/grading_engine.py

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /var/lib/math-agent/uploads \
    && chown -R appuser:appuser /srv/app /var/lib/math-agent

USER appuser
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
