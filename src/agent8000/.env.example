DATABASE_PATH=./data/homework.db
UPLOAD_DIR=./data/uploads
DIFY_API_URL=
DIFY_API_KEY=
DIFY_WORKFLOW_ID=

# Model provider. Keep local_qwen while the current A100 service is available.
LLM_PROVIDER=local_qwen
LOCAL_QWEN_MODEL=local-grade-service
QWEN_GRADING_URL=http://127.0.0.1:18080/grade-homework
LLM_REQUEST_TIMEOUT_SECONDS=1800

# Future Qwen API deployment. Do not put a real key in Git.
# LLM_PROVIDER=qwen_api
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_API_MODEL=qwen-plus
# Optional: a gateway that accepts the same images_base64/problems payload as local Qwen.
QWEN_API_GRADING_URL=

# Optional: only needed by maintenance scripts that open an SSH tunnel to the remote VLM.
VLM_SSH_HOST=
VLM_SSH_PORT=22
VLM_SSH_USER=
VLM_SSH_PASSWORD=

# 8014 internal evidence service (required when WORKBENCH_MODE=production)
EVIDENCE_API_KEY=replace-with-shared-secret
WORKBENCH_MODE=development
WORKBENCH_INTERNAL_API_KEY=replace-with-shared-secret
WORKBENCH_CORS_ORIGINS=https://your-domain.example
