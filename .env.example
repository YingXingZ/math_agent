# Copy the values you need to src/agent8000/.env or your deployment's secret store.
# Never commit real credentials, student submissions, SQLite databases, or uploads.

# Storage
DATABASE_PATH=./src/agent8000/data/homework.db
UPLOAD_DIR=./src/agent8000/data/uploads

# Authentication (set AUTH_REQUIRED=true for every public deployment)
AUTH_REQUIRED=false
SESSION_DAYS=14
SESSION_COOKIE_NAME=math_agent_session
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Grading and evidence services
LLM_PROVIDER=local_qwen
QWEN_GRADING_URL=http://127.0.0.1:18080/grade-homework
VLM_INTERNAL_API_KEY=
EVIDENCE_API_URL=http://127.0.0.1:8014/api
EVIDENCE_API_KEY=
WORKBENCH_MODE=development
WORKBENCH_INTERNAL_API_KEY=
WORKBENCH_CORS_ORIGINS=
CORS_ORIGINS=

# Optional hosted Qwen-compatible provider
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_API_MODEL=qwen-plus
QWEN_API_GRADING_URL=

# Optional Dify integration
DIFY_API_URL=
DIFY_API_KEY=
DIFY_WORKFLOW_ID=

# Queue (use RQ/Redis for production)
QUEUE_BACKEND=sqlite
REDIS_URL=
RQ_QUEUE_NAME=grading

# Evidence source roots; do not point this at untrusted uploads
SOURCE_DOCUMENT_ROOT=
